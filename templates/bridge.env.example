# Copy to the cloned app's bridge/.env; replace values locally, never commit.
HERMES_BRIDGE_HOST=0.0.0.0
HERMES_BRIDGE_PORT=8765
HERMES_BRIDGE_TOKEN=REPLACE_WITH_UNIQUE_RANDOM_TOKEN
HERMES_BRIDGE_BRAIN=hermes
HERMES_BRIDGE_API=1
HERMES_API_URL=http://127.0.0.1:8642
HERMES_API_KEY=REPLACE_WITH_YOUR_HERMES_API_SERVER_KEY
# Set to the actual executable if your install differs from the default.
# HERMES_BIN=/absolute/path/to/hermes
HERMES_AGENT_MODEL=
HERMES_AGENT_PROVIDER=
HERMES_AGENT_FALLBACK_MODEL=
HERMES_AGENT_FALLBACK_PROVIDER=
HERMES_BRIDGE_CLI_TIMEOUT=180
HERMES_BRIDGE_TTS=0
HERMES_BRIDGE_ACK=1
HERMES_BRIDGE_ACK_AFTER_S=10
